# Copy to .env (never committed). Everything is optional; defaults are safe (dry-run, public mainnet RPC).
# RPC_URL=https://api.mainnet-beta.solana.com
# WS_URL=wss://api.mainnet-beta.solana.com
# SEND_RPC_URLS=https://api.mainnet-beta.solana.com      # comma-separated; used round-robin for sendTransaction
# LIVE=I_UNDERSTAND_THIS_SPENDS_SOL                      # plus the --live flag, otherwise nothing is sent
# SPEND_CAP_SOL=0.05                                     # hard cap, max 0.1; a cap stored in data/spend-ledger.json can only go down
# KEYPAIR_PATH=/keys/burner.json                         # Solana CLI JSON keypair, mounted read-only from ./keys
# TARGET_CLIENTS=Agave,JitoLabs,AgaveBam,HarmonicAgave,Firedancer,HarmonicFiredancer,FireBAM,Rakurai
# VALIDATORS_PER_CLIENT=2
# BATCHES_PER_VALIDATOR=12
# BATCH_SIZE=8
# ARMS=F,T,N
# CU_LIMIT=8000
# FEE_LADDER=0,1000,5000,20000,50000,100000,250000,500000   # micro-lamports per CU
# LEAD_SLOTS=1                                           # send when the tip is this many slots before the window
# SEND_GAP_MS=15
# HORIZON_SLOTS=9000                                     # how far ahead to plan (9000 slots ~ 1 hour)
# PIN_VALIDATORS=                                        # comma-separated identities, overrides automatic selection
# SEED=42
